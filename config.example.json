{
  "build": {
    "name": "tw_bot",
    "version": "2.1",
    "author": "stefan2200"
  },
  "server": {
    "server": "nlc1",
    "endpoint": "https://nlc1.tribalwars.nl/game.php",
    "server_on_twstats": false
  },
  "logging": {
    "enabled": false,
    "connection_string": "file://cache/logs/twb_{ts}.log"
  },
  "notifications": {
    "enabled": false,
    "channel_id": "",
    "token": ""
  },
  "bot": {
    "active_hours": "6-23",
    "delay_factor": 1.0,
    "attack_delay_factor": 1.0,
    "active_delay": 200,
    "village_delay_min": 60,
    "village_delay_max": 180,
    "inactive_still_active": true,
    "inactive_delay": 2000,
    "add_new_villages": true,
    "village_name_template": "Village {num}",
    "village_name_number_length": 3,
    "auto_set_village_names": false,
    "user_agent": null,
    "request_rate_limit_enabled": true,
    "idle_backoff_on_error_seconds": 300,
    "pause_on_bot_protection": true,
    "humanizer_enabled": false,
    "humanizer_ambient_chance": 0.05,
    "humanizer_idle_chance": 0.0,
    "humanizer_idle_gap_min": 300,
    "humanizer_idle_gap_max": 900,
    "humanizer_warmup_after_seconds": 1800,
    "cache_gc_enabled": true,
    "cache_retention_days": 14,
    "cache_gc_interval_hours": 24,
    "cache_gc_roots": [
      "cache"
    ],
    "check_update": true
  },
  "building": {
    "manage_buildings": true,
    "default": "purple_predator",
    "max_lookahead": 2,
    "max_queued_items": 2
  },
  "units": {
    "recruit": true,
    "upgrade": true,
    "default": "basic",
    "batch_size": 25,
    "manage_defence": false,
    "remove_manual_queued": false,
    "randomize_unit_queue": true
  },
  "village_template": {
    "building": "purple_predator",
    "units": "basic",
    "managed": true,
    "scout_first": false,
    "additional_farms": [],
    "prioritize_building": false,
    "prioritize_snob": false,
    "trade_for_premium": false,
    "gather_enabled": false,
    "gather_selection": 1,
    "advanced_gather": true,
    "snobs": 0,
    "evacuate_fragile_units_on_attack": false,
    "support_others": false,
    "support_others_factor": 0.25,
    "support_others_max_villages": 2,
    "request_support_on_attack": false
  },
  "farms": {
    "farm": true,
    "min_points": 0,
    "max_points": 50,
    "find_player_owned": false,
    "search_radius": 100,
    "target_cache_max_age_hours": 24,
    "default_away_time": 3600,
    "full_loot_away_time": 1800,
    "low_loot_away_time": 7200,
    "priority_ratio": 50,
    "farm_exploration_ratio": 0.25,
    "farm_exploration_min_targets": 2,
    "max_farms": 25,
    "attack_higher_points": false,
    "force_scout_if_available": false,
    "forced_peace_times": [],
    "farm_scout_amount": 5,
    "night_bonus_start_hour": 23,
    "night_bonus_end_hour": 7,
    "night_bonus_troop_multiplier": 3.0
  },
  "map": {
    "discovery_enabled": false,
    "discovery_radius": 100,
    "discovery_step": 20,
    "max_discovery_requests_per_run": 2,
    "discovery_refresh_hours": 24,
    "fetch_delay_hours": 8
  },
  "market": {
    "auto_trade": true,
    "max_trade_duration": 1,
    "auto_remove": true,
    "trade_multiplier": true,
    "trade_multiplier_value": 1.0,
    "trade_max_per_hour": 1
  },
  "world": {
    "knight_enabled": null,
    "flags_enabled": null,
    "quests_enabled": null,
    "trade_for_premium": false,
    "archers_enabled": true,
    "building_destruction_enabled": true,
    "boosters_enabled": null,
    "game_speed": 1.0,
    "unit_speed": 1.0
  },
  "villages": {

  }
}
